# Local: copy to .env.local (gitignored). Production: Vercel -> Settings ->
# Environment Variables, then redeploy.

# Groq powers the "Ask AI" tab in the chat widget. https://console.groq.com/keys
GROQ_API_KEY=

# SMTP account used to email contact-form enquiries to the studio and a
# confirmation to the visitor. For Gmail use an App Password (Google Account
# -> Security -> 2-Step Verification -> App passwords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for implicit TLS (port 465), false for STARTTLS (587). Optional:
# guessed from the port when empty.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional. Sender shown to recipients. Gmail only allows the account itself
# (or an alias added under "Send mail as"). Default: "Forgebyte <SMTP_USER>".
MAIL_FROM="Forgebyte <admin.forgebyte@gmail.com>"
# Optional. Inbox that receives enquiries, and the Reply-To on the visitor's
# confirmation. Default: the address in lib/site.ts (CONTACT_EMAIL).
WORK_MAIL=admin.forgebyte@gmail.com
# Optional. Calendar link (Cal.com, Calendly, Google booking page…) for the
# "Book a call" button in the confirmation email. Without it, the button
# opens WhatsApp with a "book a call" message.
BOOKING_URL=

# Sheet Ninja (https://sheetninja.io): each enquiry is also added as a row to
# the enquiries Google Sheet. Optional — leave empty to skip. Copy the tab's
# endpoint from the Sheet Ninja dashboard. The token is only needed if you
# switch on protection for that endpoint.
SHEETNINJA_API_URL=
SHEETNINJA_TOKEN=

# Neon Postgres: stores contact-form submissions (90 days), Telegram chat
# links, the bot's short chat history and its rate limits. Neon console ->
# project "forgebyte" -> Connect -> copy the connection string (pooled is fine).
# Tables: npm run db:migrate (db/schema.sql). Optional: without it the form
# still emails, but there are no Telegram buttons or opt-in link.
DATABASE_URL=

# Telegram bot (setup: docs/TELEGRAM.md)
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The bot's username without @ (for the t.me link on the form's success screen).
TELEGRAM_BOT_USERNAME=
# Random secret Telegram sends with every webhook call (A-Z a-z 0-9 _ -, up to
# 256 chars). Use the same value in setWebhook. e.g. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Random secret that signs the start/button tokens. e.g. openssl rand -hex 32
TELEGRAM_LINK_SECRET=
# Chat id of the private work group that receives new enquiries (a negative
# number for groups, e.g. -1001234567890).
WORK_CHAT_ID=

# Optional. The bot answers with Groq, using GROQ_API_KEY above. Override the
# model if Groq retires the default (openai/gpt-oss-120b).
GROQ_MODEL=
