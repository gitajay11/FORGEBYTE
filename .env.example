# Groq powers the "Ask AI" tab in the chat widget.
# Get a key at https://console.groq.com/keys
#
# Local: copy this file to .env.local and paste your key there.
#        .env.local is gitignored — never commit a real key.
# Production: add GROQ_API_KEY in the Vercel dashboard under
#        Settings -> Environment Variables, then redeploy.
GROQ_API_KEY=

# Optional. Groq retires model ids periodically; override if the default
# starts returning "decommissioned". Check https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
