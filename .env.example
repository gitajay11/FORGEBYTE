# Local: copy to .env.local (gitignored). Production: Vercel -> Settings ->
# Environment Variables, then redeploy.

# Groq powers the "Ask AI" tab in the chat widget. https://console.groq.com/keys
GROQ_API_KEY=

# SMTP account used to email contact-form enquiries to the studio and a
# confirmation to the visitor. For Gmail use an App Password (Google Account
# -> Security -> 2-Step Verification -> App passwords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for implicit TLS (port 465), false for STARTTLS (587). Optional:
# guessed from the port when empty.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional. Sender shown to recipients. Gmail only allows the account itself
# (or an alias added under "Send mail as"). Default: "Forgebyte <SMTP_USER>".
MAIL_FROM=
# Optional. Inbox that receives enquiries, and the Reply-To on the visitor's
# confirmation. Default: the address in lib/site.ts (CONTACT_EMAIL).
WORK_MAIL=
# Optional. Calendar link (Cal.com, Calendly, Google booking page…) for the
# "Book a call" button in the confirmation email. Without it, the button
# opens WhatsApp with a "book a call" message.
BOOKING_URL=
