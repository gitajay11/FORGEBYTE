# Groq powers the "Ask AI" tab in the chat widget.
# Get a key at https://console.groq.com/keys
#
# Local: copy this file to .env.local and paste your key there.
#        .env.local is gitignored — never commit a real key.
# Production: add GROQ_API_KEY in the Vercel dashboard under
#        Settings -> Environment Variables, then redeploy.
GROQ_API_KEY=

# Optional. Groq retires model ids periodically; override if the default
# starts returning "decommissioned". Check https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# --- Contact form email (SMTP) ---------------------------------------------
# The contact form and chat-widget leads are emailed through this account.
# Leave these blank and submissions fall back to Formspree instead.
#
# Gmail: use an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), not your login password.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
# Other providers (Zoho, Outlook, Brevo, Resend SMTP...) work the same way.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional. Where to deliver (defaults to the site's contact email) and the
# From header (defaults to "Forgebyte <SMTP_USER>" — most providers reject
# any other From address).
# MAIL_TO=
# MAIL_FROM=
